# Galaxy-installed roles & collections (managed via requirements.yml)
galaxy_roles/*
!galaxy_roles/.gitkeep

# Local Ansible runtime cache (installed collections/roles/modules, fact cache)
.ansible/

# Development collection link farm generated by Ansible tooling
collections/

# Built collection artifacts (ansible-galaxy collection build)
*.tar.gz

# Python virtualenvs
.venv/
venv/
env/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Ansible artifacts
*.retry
.cache/
*.log
tests/output/

# Vault password files — never commit
*.vault_pass
vault_pass*
.vault-password

# Local Makefile config (committed template: .env.example)
.env

# Local inventory / secrets overrides
*.local.yml

# Editor / OS
.DS_Store
*.swp
*~
.idea/

# VS Code
# workspace settings — track only the shared extension recommendations
.vscode/*
!.vscode/extensions.json
