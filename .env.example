# Local Makefile overrides. Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Every value here has a matching fallback in the Makefile,
# so .env is optional. CLI overrides (e.g. `make run LIMIT=web`) always win.

# --- ansible-playbook targets ---
INVENTORY=inventories/production/hosts.yml
PLAYBOOK=playbooks/site.yml
LIMIT=
TAGS=

# --- molecule targets ---
ROLE=example
SCENARIO=default
