#!/usr/bin/env bash
set -euo pipefail

TOKEN_FILE="${HOME}/.config/op/op-service-account-token"

token_error() {
  cat >&2 <<EOF
ERROR: The op service account token has not been set up.
Expected a readable, non-empty token file at:
  ${TOKEN_FILE}

Create the file before retrying. The required shell setup is:
  export OP_SERVICE_ACCOUNT_TOKEN="\$(cat ~/.config/op/op-service-account-token)"

The requested command was not run.
EOF
  exit 1
}

if [[ ! -r "${TOKEN_FILE}" || ! -s "${TOKEN_FILE}" ]]; then
  token_error
fi

if [[ $# -eq 0 ]]; then
  echo "ERROR: scripts/with-op requires a command to execute." >&2
  exit 64
fi

if ! OP_SERVICE_ACCOUNT_TOKEN="$(cat "${TOKEN_FILE}")"; then
  token_error
fi

if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN//[[:space:]]/}" ]]; then
  token_error
fi

export OP_SERVICE_ACCOUNT_TOKEN
exec "$@"
