#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DEFAULTS_FILE="${SCRIPT_DIR}/../vars/defaults.yml"

one_password_vault="$(
  python3 -c '
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    value = yaml.safe_load(stream).get("onePasswordVault")
if not isinstance(value, str) or not value.strip():
    raise SystemExit("onePasswordVault is missing from vars/defaults.yml")
print(value, end="")
' "${DEFAULTS_FILE}"
)"

exec "${SCRIPT_DIR}/with-op" \
  op read "op://${one_password_vault}/host sudo password/password" --no-newline
