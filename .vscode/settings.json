{
  "ansible.python.interpreterPath": "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3",
  "yaml.schemas": {
    ".schema/ansible-vars.schema.json": [
      "*/roles/*/defaults/main.yml",
      "*/vars/defaults.yml"
    ]
  },
  "files.associations": {
    "*.yml": "ansible",
    "*/roles/*/defaults/main.yml": "yaml",
    "*/vars/defaults.yml": "yaml",
    ".ansible-lint": "yaml",
    ".yamllint.yml": "yaml"
  },
  "yaml.customTags": [
    "!vault scalar"
  ],
  "[ansible]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "ansible.validation.lint.enabled": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "ansible.validation.lint.autoFixOnSave": true
}
