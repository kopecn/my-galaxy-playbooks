---
# https://ansible.readthedocs.io/projects/lint/configuring/
profile: production

# Project convention is camelCase variable names (see
# .claude/specs/architecture/playbook-layering.md). Widen the default
# var-naming pattern (snake_case only) to also permit camelCase.
var_naming_pattern: "^[a-z_][a-zA-Z0-9_]*$"

exclude_paths:
  - .cache/
  - .github/
  - galaxy_roles/
  - tests/output/

skip_list:
  # Project convention is camelCase, and role variables are still namespaced by
  # a camelCase role prefix (e.g. vscodeExtensions, exampleMarkerPath). This rule
  # only recognizes snake_case `role_` prefixes, which camelCase cannot satisfy.
  # See .claude/specs/architecture/playbook-layering.md.
  - var-naming[no-role-prefix]

warn_list:
  - experimental

use_default_rules: true

kinds:
  - playbook: "playbooks/*.yml"
  - playbook: "**/molecule/*/{converge,prepare,verify,side_effect,cleanup}.yml"
  - yaml: "**/molecule/*/molecule.yml"
  - tasks: "roles/**/tasks/*.yml"
  - vars: "inventories/**/group_vars/*.yml"
