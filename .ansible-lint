---
# https://ansible.readthedocs.io/projects/lint/configuring/
profile: production

# Project convention is mixed case variable names
var_naming_pattern: "^[a-z_][a-zA-Z0-9_]*$"

exclude_paths:
  - .cache/
  - .github/
  - galaxy_roles/
  - tests/output/

skip_list:
  # Project convention is mixed case, and role variables
  - var-naming[no-role-prefix]

warn_list:
  - experimental

use_default_rules: true

kinds:
  - playbook: "playbooks/*.yml"
  - playbook: "**/molecule/*/{converge,prepare,verify,side_effect,cleanup}.yml"
  - yaml: "**/molecule/*/molecule.yml"
  - tasks: "roles/**/tasks/*.yml"
